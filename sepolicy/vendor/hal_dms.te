# Dolby DMS: AIDL HAL registered in servicemanager
#
# Registration needs binder access to servicemanager
allow hal_aidl_dms_default servicemanager:binder { call transfer };
allow hal_aidl_dms_default servicemanager:service_manager list;

# Publish the service
add_service(hal_aidl_dms_default, vendor_dms_service)
