type hal_aidl_dms_default, domain;
hal_server_domain(hal_aidl_dms_default, hal_aidl_dms)

type hal_aidl_dms_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_aidl_dms_default)

allow hal_aidl_dms_default vendor_data_file:file { rw_file_perms create unlink };
allow hal_aidl_dms_default vendor_data_file:dir { rw_file_perms add_name remove_name };
allow hal_aidl_dms_default mediacodec:binder call;
allow hal_aidl_dms_default property_socket:sock_file write;
binder_call(hal_aidl_dms_default, hal_audio_default)
binder_call(hal_aidl_dms_default, platform_app)
